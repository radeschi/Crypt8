{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "orangeEncrypt",
  "mainBinaryName": "orangeEncrypt",
  "version": "1.0.8",
  "identifier": "app.orange.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "orangeEncrypt",
        "width": 300,
        "height": 420,
        "minWidth": 300,
        "maxWidth": 300,
        "minHeight": 420,
        "maxHeight": 420,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "center": true,
        "transparent": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 16 },
        "shadow": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OEQ5QTY3NDYyNzMwODYKUldTR01DZEdaNXFOUmV5b3RHSXRhaXczS2liTWphcDlFTSt3Mi96MS9qSU1MUnowV0dDcXoxRTIK",
      "endpoints": [
        "https://github.com/radeschi/orangeEncrypt/releases/latest/download/latest.json"
      ]
    }
  }
}
