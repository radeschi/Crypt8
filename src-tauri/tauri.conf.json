{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "orangeEncrypt",
  "mainBinaryName": "orangeEncrypt",
  "version": "1.0.2",
  "identifier": "app.orange.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "orangeEncrypt",
        "width": 300,
        "height": 420,
        "minWidth": 300,
        "maxWidth": 300,
        "minHeight": 420,
        "maxHeight": 420,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "center": true,
        "transparent": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 16 },
        "shadow": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
